  "videos": {
    "a-continue-to-a04-choice.mp4": {
      "duration": 40.557,
      "cues": [
        { "start": 4.16, "end": 9.74, "text": "队长，这只手不能再使劲了。后面的装备，我们来背" },
        { "start": 21.84, "end": 26.28, "text": "时间还够。照现在走，或者慢一点都赶得上" },
        { "start": 32.56, "end": 35.08, "text": "再往前，回头就难了" },
        { "start": 36.52, "end": 38.0, "text": "现在下撤，还能接山谷" },
        { "start": 39.04, "end": 40.26, "text": "但赶不上期限了" }
      ]
    },
    "a-route-to-a02-choice.mp4": {
      "duration": 40.538,
      "cues": [
        { "start": 4.64, "end": 9.26, "text": "按这个速度，我们不是勉强赶上，是还有余量" },
        { "start": 30.58, "end": 33.44, "text": "还能往前，那边也能躲" },
        { "start": 34.64, "end": 36.76, "text": "现在停，时间优势会掉" },
        { "start": 37.3, "end": 40.28, "text": "继续，风险已经不是出发时那个风险了" }
      ]
    },
    "a03b-shelter-restart.mp4": {
      "duration": 12.256,
      "cues": [
        { "start": 1.84, "end": 4.08, "text": "休息这两天有用，手稳多了" },
        { "start": 6.58, "end": 9.44, "text": "人缓过来了，不过我们也比原计划晚了两天" }
      ]
    },
    "a4fb1.mp4": {
      "duration": 7.328,
      "cues": [
        { "start": 0.36, "end": 2.68, "text": "不改路，按现在的速度走" }
      ]
    },
    "a4fb2-slow-down.mp4": {
      "duration": 12.256,
      "cues": [
        { "start": 0.84, "end": 3.28, "text": "速度降一点，我走你旁边" }
      ]
    },
    "a4fb3-retreat-to-valley.mp4": {
      "duration": 24.512,
      "cues": [
        { "start": 1.92, "end": 3.96, "text": "先下到低处，再改走谷地" }
      ]
    },
    "b-accelerate-to-b04-choice.mp4": {
      "duration": 36.667,
      "cues": [
        { "start": 4.44, "end": 7.2, "text": "午休缩短，天黑前再多走一段" },
        { "start": 8.18, "end": 10.92, "text": "可以，但少休息，后面会更累" },
        { "start": 14.28, "end": 16.18, "text": "这三天追回来差不多一天" },
        { "start": 18.98, "end": 23.16, "text": "还能走，但再这么赶，大家都撑不久" },
        { "start": 24.76, "end": 27.42, "text": "照这三天的速度，还有机会赶上" },
        { "start": 29.0, "end": 31.42, "text": "但再赶下去，休息也补不回来" },
        { "start": 32.92, "end": 33.9, "text": "要么继续赶" },
        { "start": 34.52, "end": 35.6, "text": "要么现在降速" }
      ]
    },
    "b-final-dawn.mp4": {
      "duration": 12.256,
      "cues": [
        { "start": 4.08, "end": 4.98, "text": "天亮前走" },
        { "start": 5.7, "end": 6.6, "text": "我盯着状态" },
        { "start": 7.46, "end": 8.7, "text": "谁撑不住，马上说" }
      ]
    },
    "b-final-rest.mp4": {
      "duration": 12.256,
      "cues": [
        { "start": 3.36, "end": 5.84, "text": "那就把休息补回来，别再硬撑" },
        { "start": 8.8, "end": 11.8, "text": "好，按能走完的速度走" }
      ]
    },
    "b-route-to-b02-choice.mp4": {
      "duration": 28.167,
      "cues": [
        { "start": 8.72, "end": 13.52, "text": "路没问题，照这个走能出去，就是长" },
        { "start": 16.4, "end": 19.18, "text": "这六天一路都顺，速度也正常" },
        { "start": 20.36, "end": 23.62, "text": "但按现在的节奏走，到镇上大概还要十天" },
        { "start": 26.5, "end": 27.66, "text": "我们只剩八天" }
      ]
    },
    "b-steady-to-b04-choice.mp4": {
      "duration": 36.667,
      "cues": [
        { "start": 3.22, "end": 5.54, "text": "那就不改节奏，照现在这样走" },
        { "start": 6.38, "end": 8.1, "text": "好，我按这个速度往后算" },
        { "start": 16.88, "end": 20.02, "text": "再照这个速度走，十四天肯定赶不上了" },
        { "start": 25.26, "end": 28.08, "text": "要追，就得从今天开始把时间抢回来" },
        { "start": 29.54, "end": 32.18, "text": "现在才追，比三天前更伤人" },
        { "start": 33.12, "end": 34.06, "text": "那就定吧" },
        { "start": 34.06, "end": 36.2, "text": "是冲，还是照现在走" }
      ]
    },
    "c-route-to-c02-choice.mp4": {
      "duration": 36.667,
      "cues": [
        { "start": 18.36, "end": 23.84, "text": "两天到了。我们知道得比第一天多了，时间也少了两天" },
        { "start": 27.7, "end": 29.0, "text": "高地会有暴风" },
        { "start": 29.0, "end": 30.52, "text": "山口还看不准" },
        { "start": 31.48, "end": 32.72, "text": "我们可以再等一天" },
        { "start": 34.42, "end": 35.96, "text": "也可以现在改走山谷" }
      ]
    },
    "c03-second-information.mp4": {
      "duration": 12.256,
      "cues": [
        { "start": 0.0, "end": 4.46, "text": "山口还没确定会封死，最坏的风过后会缓一些" },
        { "start": 4.9, "end": 8.14, "text": "但没人能保证一路顺利，我们只剩十一天" },
        { "start": 8.94, "end": 12.12, "text": "走山路，转山谷，还是不再赶期限" }
      ]
    },
    "c04m-low-mountain-route.mp4": {
      "duration": 12.256,
      "cues": [
        { "start": 1.0, "end": 1.88, "text": "先走低处" },
        { "start": 3.36, "end": 5.4, "text": "等风小了，再上山口" }
      ]
    },
    "c04va-day3-to-valley.mp4": {
      "duration": 24.512,
      "cues": [
        { "start": 1.46, "end": 2.48, "text": "那就走山谷" },
        { "start": 3.88, "end": 4.94, "text": "按今天重算" },
        { "start": 6.2, "end": 8.56, "text": "前面等掉的三天，拿不回来了" }
      ]
    },
    "c04vb-day7-to-valley.mp4": {
      "duration": 24.512,
      "notes": "8.26–9.24 秒存在无法可靠辨识的生成杂音，三种本地识别模型结果不一致，未强行编写字幕",
      "cues": [
        { "start": 4.42, "end": 5.58, "text": "明白，先下低处" },
        { "start": 6.22, "end": 8.18, "text": "我从这里开始重算谷地路线" }
      ]
    },
    "c05-information-proves-useful.mp4": {
      "duration": 12.256,
      "cues": [
        { "start": 1.28, "end": 3.96, "text": "现在这个风，能走" },
        { "start": 5.46, "end": 6.86, "text": "至少这三天没白等" }
      ]
    },
    "c06-reality-update-choice.mp4": {
      "duration": 12.256,
      "cues": [
        { "start": 2.16, "end": 4.46, "text": "风是小了，可比预想的慢" },
        { "start": 5.06, "end": 7.28, "text": "照原计划还来得及" },
        { "start": 7.28, "end": 9.72, "text": "要是再观察一段，时间就很紧了" }
      ]
    },
    "c2fb1-wait-one-more-day.mp4": {
      "duration": 12.256,
      "cues": [
        { "start": 3.26, "end": 4.64, "text": "好，再等一天" },
        { "start": 6.0, "end": 9.34, "text": "明天不管消息怎样，我们都得动身" }
      ]
    },
    "c2fb2-leave-for-valley.mp4": {
      "duration": 24.512,
      "cues": [
        { "start": 5.6, "end": 7.68, "text": "好，山口不等了，走山谷" },
        { "start": 8.18, "end": 9.82, "text": "我按从今天出发重新算" }
      ]
    },
    "c6fb2-observe-and-buffer.mp4": {
      "duration": 12.256,
      "cues": [
        { "start": 2.92, "end": 5.54, "text": "那就慢一点，先看清前面的天气再上" },
        { "start": 6.44, "end": 9.0, "text": "照这样走，最后大概只剩一天" }
      ]
    },
    "d-reverse-to-d05-choice.mp4": {
      "duration": 37.5,
      "cues": [
        { "start": 0.0, "end": 1.56, "text": "那就按现在的天气走" },
        { "start": 1.86, "end": 4.16, "text": "我从今天重新按八天多的窗口算" },
        { "start": 4.48, "end": 7.64, "text": "手比第一天好，但别把这五天当没花过" },
        { "start": 14.12, "end": 16.96, "text": "天气比第一天好，手也比第一天稳" },
        { "start": 18.14, "end": 20.04, "text": "可时间不是第一天的时间了" },
        { "start": 24.86, "end": 26.88, "text": "这段比我们算的慢了一点" },
        { "start": 29.54, "end": 31.78, "text": "按现在这个速度继续，窗口还在" },
        { "start": 31.78, "end": 33.68, "text": "但只剩几个小时的余量" },
        { "start": 33.68, "end": 36.02, "text": "要把强度降下来，人会舒服很多" },
        { "start": 36.02, "end": 37.3, "text": "就是时间会过去" }
      ]
    },
    "d-route-to-d03-choice.mp4": {
      "duration": 32.0,
      "cues": [
        { "start": 3.7, "end": 7.4, "text": "这两天，山口那边的风不适合硬上" },
        { "start": 7.4, "end": 10.7, "text": "比第一天稳多了" },
        { "start": 12.28, "end": 15.28, "text": "至少这几天，人和状态都保住了" },
        { "start": 17.14, "end": 20.7, "text": "风下来了一截，不是长期稳定" },
        { "start": 20.7, "end": 23.92, "text": "但和前几天，已经不是一回事了" },
        { "start": 24.6, "end": 25.96, "text": "我们也不是第一天了" },
        { "start": 27.16, "end": 28.66, "text": "还剩八天多一点" },
        { "start": 30.12, "end": 31.48, "text": "手比出发那天稳" }
      ]
    },
    "d-wait-to-result.mp4": {
      "duration": 28.0,
      "cues": [
        { "start": 6.38, "end": 7.74, "text": "好，那就不改计划" },
        { "start": 20.98, "end": 22.06, "text": "十四天过去了" },
        { "start": 22.76, "end": 24.26, "text": "人都在，状态也在" },
        { "start": 24.62, "end": 26.44, "text": "天气真正稳下来，我们回去" }
      ]
    },
    "d5fb1.mp4": {
      "duration": 8.0,
      "cues": [
        { "start": 0.0, "end": 2.06, "text": "那就继续按这个速度走" },
        { "start": 2.34, "end": 5.74, "text": "好，我盯着状态，能撑就走" }
      ]
    },
    "d5fb2.mp4": {
      "duration": 8.0,
      "cues": [
        { "start": 0.0, "end": 2.4, "text": "那就按人能稳稳走出去的速度" },
        { "start": 5.5, "end": 7.64, "text": "这样走，十四天会过去" }
      ]
    },
    "public-intro.mp4": {
      "duration": 97.667,
      "cues": [
        { "start": 1.44, "end": 3.58, "text": "队长，找到了" },
        { "start": 4.7, "end": 7.66, "text": "这个点的情况，比我们之前看到的都好" },
        { "start": 12.58, "end": 15.48, "text": "三个月的赌注，终于有了答案" },
        { "start": 20.3, "end": 21.78, "text": "但地还不是我们的" },
        { "start": 23.26, "end": 24.48, "text": "期权只剩十四天" },
        { "start": 25.06, "end": 28.02, "text": "我们得在这十四天里回去完成相关手续" },
        { "start": 30.44, "end": 31.9, "text": "按这份办理安排" },
        { "start": 33.02, "end": 35.52, "text": "最后确认必须你本人到场" },
        { "start": 36.3, "end": 37.3, "text": "队友代不了" },
        { "start": 37.74, "end": 40.14, "text": "远程确认也不能替代这一步" },
        { "start": 40.98, "end": 44.18, "text": "错过期限，地主很可能重新处置这块地" },
        { "start": 44.96, "end": 48.52, "text": "真进入竞价，我们的钱未必争得过别人" },
        { "start": 51.16, "end": 53.42, "text": "翻山通常七到十天" },
        { "start": 54.08, "end": 56.54, "text": "快，但山口不一定让我们过去" },
        { "start": 57.0, "end": 58.92, "text": "走山谷，两到三周" },
        { "start": 59.44, "end": 61.18, "text": "稳一些，也更耗人" },
        { "start": 62.06, "end": 65.46, "text": "现在还说不准这场天气会不会真的压下来" },
        { "start": 66.12, "end": 69.16, "text": "再过四十八小时，我们会知道得更多" },
        { "start": 71.02, "end": 73.4, "text": "如果真有暴风，还要再看一天" },
        { "start": 74.26, "end": 76.42, "text": "才能更清楚山口到底能不能走" },
        { "start": 82.28, "end": 83.38, "text": "其他状态还行" },
        { "start": 84.2, "end": 85.14, "text": "问题在这只手" },
        { "start": 85.52, "end": 86.56, "text": "平时看不出来" },
        { "start": 86.56, "end": 89.46, "text": "但突然使不上劲时，你会控制不稳" },
        { "start": 93.88, "end": 96.5, "text": "队长，决定吧" }
      ]
    },
